# ── Proxy WebSocket Orkestra Voice — variables d'environnement ───────────────
# Copiez en .env (ou configurez sur Railway/Render/Fly) puis adaptez.

# Port d'écoute (Railway/Render l'injectent souvent automatiquement).
PORT=8787

# Origines navigateur autorisées (CSV). Vide = toutes (à restreindre en prod).
# Ex : https://orkestra.vercel.app,https://www.mondomaine.com
ALLOWED_ORIGINS=

# ── Clé Gemini : deux options (BYOK prioritaire, sinon clé d'env) ────────────

# Option A — BYOK via Orkestra (clé par utilisateur, jamais stockée sur le proxy).
# URL de l'endpoint Next + secret partagé (à définir AUSSI sur Vercel : VOICE_PROXY_SECRET).
ORKESTRA_RESOLVE_URL=
VOICE_PROXY_SECRET=

# Option B — clé Gemini unique côté proxy (repli si pas de BYOK).
GEMINI_API_KEY=

# ── Modèle / endpoint Live (optionnels) ─────────────────────────────────────
# Modèle Live half-cascade par défaut (function calling fiable). Surchargez au besoin.
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview
# Endpoint WS Google (clé API → v1beta). Ne changez que si nécessaire.
# GEMINI_LIVE_WS_BASE=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent
