# Orkestra AI — variables d'environnement

# Clé maîtresse pour chiffrer les clés API clients (AES-256-GCM).
# Générer avec: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# Base de données (Prisma) — à brancher en production
DATABASE_URL="postgresql://user:password@localhost:5432/orkestra"

# Mode mock : si "true" (défaut), les générations IA sont simulées (templates).
# Passer à "false" pour activer les VRAIS appels OpenAI quand une clé est connectée.
ORKESTRA_MOCK_MODE=true

# Persistance des clés API (chiffrées) :
#  - si DATABASE_URL est défini → stockage Prisma/Postgres (recommandé en prod).
#  - sinon → stockage in-memory (non persistant entre redémarrages, dev/preview).
# Après avoir défini DATABASE_URL : npx prisma migrate deploy
